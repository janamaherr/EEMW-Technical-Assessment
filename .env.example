# Used by docker-compose.yml
POSTGRES_USER=docrepo
POSTGRES_PASSWORD=docrepo
POSTGRES_DB=docrepo
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application settings (mirrors backend/.env.example)
DATABASE_URL=postgresql://docrepo:docrepo@localhost:5432/docrepo?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
