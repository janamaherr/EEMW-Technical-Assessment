# Optional overrides for docker-compose.yml. Copy to .env to change them; without a .env file
# the defaults below are used. (Local `npm run dev` uses backend/.env and frontend/.env.local.)

# PostgreSQL
POSTGRES_USER=docrepo
POSTGRES_PASSWORD=docrepo
POSTGRES_DB=docrepo
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend (full Docker stack). Use a long random secret outside local demos.
JWT_SECRET=dev-only-change-me-please-32-chars-min
JWT_EXPIRES_IN=2d
MAX_FILE_SIZE_MB=20
CORS_ORIGIN=http://localhost:3000
