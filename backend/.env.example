DATABASE_URL=postgresql://docrepo:docrepo@localhost:5432/docrepo?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# Auth (use a long random string in real deployments)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=2d

# Frontend origin allowed by CORS (comma-separated for several)
CORS_ORIGIN=http://localhost:3000
